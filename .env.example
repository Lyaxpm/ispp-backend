# ── Database ──────────────────────────────────────────────────────────
# Lokal:    postgresql://isp:isp_secret@localhost:5432/isp_platform?schema=public
# Supabase: pakai "Connection string" mode Transaction (port 6543) lalu
#           tambahkan ?pgbouncer=true di akhir agar cocok dengan PgBouncer.
#           Contoh:
#           postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://isp:isp_secret@localhost:5432/isp_platform?schema=public"

# ── Redis / BullMQ ────────────────────────────────────────────────────
# Lokal: redis://localhost:6379
# Cloud: Upstash Redis → salin "Redis URL" (rediss://...).
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET="ganti-dengan-secret-minimal-32-karakter-yang-kuat"
JWT_EXPIRES_IN="1d"

# Kunci enkripsi AES-256-GCM untuk kredensial tersimpan (router/OLT/dll).
# Wajib 32 byte: 64 karakter hex ATAU 32 karakter biasa.
CREDENTIALS_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ── Payment Gateway ───────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# ── Notifikasi ────────────────────────────────────────────────────────
WA_GATEWAY_URL="http://localhost:3002"
WA_GATEWAY_API_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_NOC_CHAT_ID=""

# ── TR-069 / GenieACS ─────────────────────────────────────────────────
GENIEACS_URL="http://localhost:7557"
GENIEACS_USERNAME=""
GENIEACS_PASSWORD=""

# ── Aplikasi ──────────────────────────────────────────────────────────
# PORT otomatis diisi Railway/Render/Fly (didahulukan dari APP_PORT).
# APP_PORT hanya untuk jalan lokal / docker-compose.
APP_PORT="3000"
# Isi dengan URL frontend production, boleh beberapa dipisah koma.
# Contoh: CORS_ORIGIN="https://ispp.vercel.app"
CORS_ORIGIN="http://localhost:3001"

# ── Billing ───────────────────────────────────────────────────────────
PPN_RATE="11"
GRACE_PERIOD_DAYS="3"
ISOLATION_TIER1_DAYS="7"
ISOLATION_TIER2_DAYS="14"

# ── Workers ───────────────────────────────────────────────────────────
# Set false bila BullMQ worker dijalankan sebagai proses terpisah.
WORKERS_ENABLED="true"
